{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Diamond Music Manager",
  "version": "0.1.0",
  "identifier": "com.diaorg.apps.playlistmaker",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": false,
      "tooltip": "Diamond Music Manager",
      "showMenuOnLeftClick": false
    },
    "windows": [
      {
        "title": "Diamond Music Manager",
        "width": 1100,
        "height": 700,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; media-src 'self' asset: http://asset.localhost https://asset.localhost; img-src 'self' asset: http://asset.localhost https://asset.localhost data:",
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/**/*", "/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
